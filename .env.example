# ── video-engine-starter — Environment Variables ──────────────────────────────
#
# Copy this file to .env and fill in keys you have.
# You do NOT need all of them — the pipeline cascades through available providers.
# Minimum viable setup (fully free, no keys): just install edge-tts Python package.
#
# pip install edge-tts    (for TTS fallback)
# ffmpeg must be in PATH  (for audio duration measurement)

# ── LLM Providers ────────────────────────────────────────────────────────────
# Priority: NIM → OpenCode Zen → Groq → Gemini → Together.ai
# Free tiers as of 2026: Groq (7k req/day), Gemini (1.5M tokens/day), Together (trial credits)

# NVIDIA NIM — best quality, llama-3.3-70b-instruct
# Sign up: https://build.nvidia.com — free API key, 1000 credits/month
NIM_API_KEY=

# OpenCode Zen — minimax-m2-5-free model
# Sign up: https://opencode.ai
OPENCODE_ZEN_API_KEY=

# Groq — llama-3.3-70b-versatile, extremely fast inference
# Sign up: https://console.groq.com — free tier generous
GROQ_API_KEY=

# Google Gemini — gemini-1.5-flash, free tier 1.5M tokens/day
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Together.ai — Mixtral-8x7B, wide model selection
# Sign up: https://api.together.xyz
TOGETHER_API_KEY=

# ── TTS Providers ─────────────────────────────────────────────────────────────
# Priority: Sarvam (Indian langs) → ElevenLabs → OpenAI → PlayHT → Edge TTS → Google TTS
# Edge TTS is always available for free (no key) — best free fallback

# Sarvam AI — BEST for Hindi / all Indian languages (hi-IN, bn-IN, ta-IN, etc.)
# Sign up: https://dashboard.sarvam.ai — 10,000 chars/month free
# Model: bulbul:v2 | Voices: anushka, abhilasha, arjun (Hindi), meera, kalpana (others)
SARVAM_API_KEY=

# ElevenLabs — best English quality + word-level timing
# Sign up: https://elevenlabs.io — 10,000 chars/month free
ELEVEN_LABS_API_KEY=
# Voice ID — find yours at elevenlabs.io/voice-library
ELEVEN_LABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# OpenAI TTS — great quality English, tts-1 model
# Voices: alloy, echo, fable, onyx, nova, shimmer
# Cost: $15/1M chars (no meaningful free tier)
OPENAI_API_KEY=

# PlayHT — wide voice selection including Indian voices
# Sign up: https://play.ht
PLAYHT_API_KEY=
PLAYHT_USER_ID=

# ── TTS Language / Voice Defaults ────────────────────────────────────────────
# Override default language for audio generation
# en = English (default), hi = Hindi, ta = Tamil, bn = Bengali, etc.
TTS_LANG=en

# Default Edge TTS voice for English content
TTS_VOICE=en-IN-NeerjaNeural

# Default Edge TTS voice for Hindi content
TTS_VOICE_HI=hi-IN-SwaraNeural

# ── Image Generation ──────────────────────────────────────────────────────────
# Pollinations.ai is used by default — completely free, no key needed.
# No config required.

# ── Notes ─────────────────────────────────────────────────────────────────────
# • Images: Pollinations.ai is fully free — no key needed at all
# • TTS: Edge TTS (Microsoft) is free — just `pip install edge-tts`
# • LLM: Groq and Gemini both have generous free tiers
# • Remotion: free for non-commercial use (remotion.dev/license)
